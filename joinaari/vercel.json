{
  "buildCommand": "node .checks/claims.js && node .checks/fees.js",
  "outputDirectory": ".",
  "framework": null,
  "functions": {
    "api/parse-license.js": {
      "maxDuration": 30
    },
    "api/ica-pdf.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/",
      "destination": "/api/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog?slug=:slug"
    }
  ],
  "redirects": [
    {
      "source": "/.checks/:path*",
      "destination": "/",
      "permanent": false
    }
  ]
}
